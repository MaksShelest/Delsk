<Project>
  <PropertyGroup>
    <!-- Godot's "Export With Debug" publishes ExportDebug. Apply the same flavour
         to every project in that graph, including Core/Hosting and its references. -->
    <DelskDeveloper Condition="'$(DelskDeveloper)' == '' and '$(Configuration)' == 'ExportDebug'">true</DelskDeveloper>
    <DelskDeveloper Condition="'$(DelskDeveloper)' == ''">false</DelskDeveloper>
    <DefineConstants Condition="'$(DelskDeveloper)' == 'true'">$(DefineConstants);DELSK_DEVELOPER</DefineConstants>
    <BaseIntermediateOutputPath Condition="'$(DelskDeveloper)' == 'true'">obj/developer/</BaseIntermediateOutputPath>
    <BaseOutputPath Condition="'$(DelskDeveloper)' == 'true'">bin/developer/</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/bin/**</DefaultItemExcludes>
    <NuGetLockFilePath Condition="'$(DelskDeveloper)' == 'true'">$(MSBuildProjectDirectory)/packages.developer.lock.json</NuGetLockFilePath>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Platform publish must not overwrite the ordinary locked restore used by core CI. -->
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/obj/runtime-locks/$(RuntimeIdentifier).lock.json</NuGetLockFilePath>
    <Authors>Шелестов Максим Евгеньевич</Authors>
  </PropertyGroup>
  <Target Name="DisallowDeveloperRelease" BeforeTargets="CoreCompile" Condition="'$(DelskDeveloper)' == 'true' and ('$(Configuration)' == 'Release' or '$(Configuration)' == 'ExportRelease')">
    <Error Text="Developer interventions are forbidden in Release/ExportRelease. Use a debug export (ExportDebug) or the isolated Debug Developer package." />
  </Target>
</Project>
