<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>Delsk.Client</AssemblyName>
    <NuGetLockFilePath Condition="('$(Configuration)' == 'ExportRelease' or '$(Configuration)' == 'ExportDebug') and '$(DelskDeveloper)' != 'true' and '$(RuntimeIdentifier)' == ''">$(MSBuildProjectDirectory)/packages.release.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(Configuration)' == 'ExportDebug' and '$(DelskDeveloper)' == 'true' and '$(RuntimeIdentifier)' == ''">$(MSBuildProjectDirectory)/packages.developer.export.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup Condition="'$(DelskDeveloper)' == 'true'"><ProjectReference Include="../Simulation.Developer/Simulation.Developer.csproj" /></ItemGroup>
  <Target Name="RequireIsolatedDeveloperPackage" BeforeTargets="PrepareForBuild" Condition="'$(DelskDeveloper)' == 'true'">
    <Error Condition="'$(DelskDeveloperPackage)' != 'true'" Text="Use scripts/build_developer_client.py for an isolated Developer client package." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="../Simulation.Hosting/Simulation.Hosting.csproj" />
    <ProjectReference Include="../Agents.Algorithmic/Agents.Algorithmic.csproj" />
    <ProjectReference Include="../Agents.Llm/Agents.Llm.csproj" />
    <EmbeddedResource Include="../../scenarios/baseline-economy.json" LogicalName="Play.baseline-economy.json" />
    <EmbeddedResource Include="../../scenarios/baseline-controllers.json" LogicalName="Play.baseline-controllers.json" />
    <EmbeddedResource Include="../../scenarios/baseline-politics.json" LogicalName="Play.baseline-politics.json" />
    <EmbeddedResource Include="../../scenarios/baseline-politics-controllers.json" LogicalName="Play.baseline-politics-controllers.json" />
    <EmbeddedResource Include="../../scenarios/logistics-cycle.json" LogicalName="Play.logistics-cycle.json" />
    <EmbeddedResource Include="../../scenarios/economic-cycle.json" LogicalName="Fixture.scenario.json" />
    <EmbeddedResource Include="../../scenarios/platform-cycle.commands.jsonl" LogicalName="Fixture.commands.jsonl" />
    <EmbeddedResource Include="../../scenarios/platform-cycle.checkpoints.csv" LogicalName="Fixture.checkpoints.csv" />
    <EmbeddedResource Include="../../scenarios/elections.json" LogicalName="Fixture.elections.json" />
    <EmbeddedResource Include="../../scenarios/platform-elections.commands.jsonl" LogicalName="Fixture.elections.commands.jsonl" />
    <EmbeddedResource Include="../../scenarios/platform-elections.checkpoints.csv" LogicalName="Fixture.elections.checkpoints.csv" />
    <EmbeddedResource Include="../../scenarios/support-cycle.json" LogicalName="Fixture.support.json" />
    <EmbeddedResource Include="../../scenarios/platform-support.commands.jsonl" LogicalName="Fixture.support.commands.jsonl" />
    <EmbeddedResource Include="../../scenarios/platform-support.checkpoints.csv" LogicalName="Fixture.support.checkpoints.csv" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../scenarios/presentation-map-two.json" LogicalName="Play.presentation-map-two.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../config/economy.json" LogicalName="Play.economy.json" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../scenarios/stopped-elections.json" LogicalName="Fixture.stopped.json" />
    <EmbeddedResource Include="../../scenarios/platform-stopped.commands.jsonl" LogicalName="Fixture.stopped.commands.jsonl" />
    <EmbeddedResource Include="../../scenarios/platform-stopped.final.sha256" LogicalName="Fixture.stopped.final.sha256" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../scenarios/presentation-map-three.json" LogicalName="Play.presentation-map-three.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../scenarios/physical-automation.json" LogicalName="Fixture.physical-automation.json" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../scenarios/platform-physical.commands.jsonl" LogicalName="Fixture.physical.commands.jsonl" />
    <EmbeddedResource Include="../../scenarios/platform-physical.checkpoints.csv" LogicalName="Fixture.physical.checkpoints.csv" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../scenarios/presentation-map-one-v2.json" LogicalName="Play.presentation-map-one-v2.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../scenarios/presentation-map-two-v2.json" LogicalName="Play.presentation-map-two-v2.json" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../scenarios/participant-trade.json" LogicalName="Fixture.trade.json" />
    <EmbeddedResource Include="../../scenarios/platform-trade.commands.jsonl" LogicalName="Fixture.trade.commands.jsonl" />
    <EmbeddedResource Include="../../scenarios/platform-trade.checkpoints.csv" LogicalName="Fixture.trade.checkpoints.csv" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../scenarios/presentation-map-one-v3.json" LogicalName="Play.presentation-map-one-v3.json" />
    <EmbeddedResource Include="../../scenarios/presentation-map-two-v3.json" LogicalName="Play.presentation-map-two-v3.json" />
    <EmbeddedResource Include="../../scenarios/presentation-map-three-v2.json" LogicalName="Play.presentation-map-three-v2.json" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../scenarios/food-chain.json" LogicalName="Fixture.food.json" />
    <EmbeddedResource Include="../../scenarios/platform-food.commands.jsonl" LogicalName="Fixture.food.commands.jsonl" />
    <EmbeddedResource Include="../../scenarios/platform-food.checkpoints.csv" LogicalName="Fixture.food.checkpoints.csv" />
  </ItemGroup>
</Project>
